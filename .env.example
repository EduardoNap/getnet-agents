# Required
ANTHROPIC_API_KEY=sk-ant-...
# Or mount the key as a secret file and point to it; then ANTHROPIC_API_KEY is not needed:
# ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key

# Optional
ANTHROPIC_MODEL=claude-sonnet-5-5
# Point the router at a smaller, faster model if you want lower latency:
# ROUTER_MODEL=claude-haiku-5-5
# The model that grades answers in evals/. Keep it different from ANTHROPIC_MODEL.
# JUDGE_MODEL=claude-opus-5-5

# Requests per principal per minute
# RATE_LIMIT_PER_MINUTE=30

# Identity: the public keys that verify tokens, and who must have issued them.
# In production, point AUTH_JWKS_URL at the key set of your login service (its "jwks_uri").
# In the demo the keys are created by `python -m app.devtokens`, which writes the key set to a file.
# AUTH_JWKS_URL=https://login.example.com/.well-known/jwks.json
# AUTH_JWKS_FILE=/app/state/keys/jwks.json
# AUTH_ISSUER=getnet-demo-idp
# AUTH_AUDIENCE=getnet-agents

# Send a span per agent step to an OpenTelemetry collector
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
